# Whitelist: ignore everything, then re-include only the files used for the
# weather-zone clustering in the paper (Supplementary Material, Section S1).
/*

# Repository files
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt

# Pipeline: yearly CFs -> concatenate_cf_data.jl -> *_fullperiod.csv -> aggregated_distance_correlation.py
!/concatenate_cf_data.jl
!/aggregated_distance_correlation.py

# Input data: yearly onshore wind and solar PV capacity factors, 1979-2019
# (the merged *_fullperiod.csv files exceed GitHub's 100 MB limit and are regenerated by concatenate_cf_data.jl)
!/cf_data/
/cf_data/*
!/cf_data/cfwind_*.csv
!/cf_data/cfsolar_*.csv

# Figures reported in the paper (Figures S1, S2 and the weather-zone map)
!/plots/
/plots/*
!/plots/dendrogram_aggregated_distance_corr_41years.pdf
!/plots/silhouette_aggregated_distance_corr_41years.pdf
!/plots/WZ_aggregated_distance_average_41years_map.pdf

# OS / Python clutter (in case it lands inside a whitelisted folder)
.DS_Store
__pycache__/
*.pyc
